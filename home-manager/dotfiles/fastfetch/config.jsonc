{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "key": {
            "type": "both",
            "paddingLeft": 2,
            "width": 20
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "|-------------------------------------------------------|\u001b[40D: {#1}{user-name} @ {host-name}{#} :"
        },
        {
            "type": "brightness",
            "key": "Brightness",
            "keyColor": "yellow"
        },
        {
            "type": "cpuusage",
            "key": "CPU Usage",
            "keyColor": "green",
            "format": "{1}"
        },
        {
            "type": "gpuusage",
            "key": "GPU Usage",
            "keyColor": "green",
            "driverSpecific": true
        },
        {
            "type": "temp",
            "key": "Temp",
            "keyColor": "green",
            "path": "/sys/class/thermal/thermal_zone0/temp"
        },
        {
            "type": "datetime",
            "key": "Date & Time",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "yellow"
        },
        {
            "type": "localip",
            "key": "Local IP",
            "keyColor": "cyan",
            "compact": true
        },
        {
            "type": "publicip",
            "key": "Public IP",
            "keyColor": "cyan"
        },
        {
            "type": "wifi",
            "key": "Wifi",
            "keyColor": "cyan",
            "format": "{ssid} ({signal-quality})"
        },
        {
            "type": "traffic",
            "key": "Traffic",
            "keyColor": "cyan",
            "interface": "wlan0"
        },
        {
            "type": "sound",
            "key": "Sound",
            "keyColor": "magenta"
        },
        {
            "type": "battery",
            "key": "Battery",
            "keyColor": "red",
            "format": "{capacity} [{status}]"
        },
        {
            "type": "custom",
            "keyIcon": "",
            "key": "Disks"
        },
        {
            "type": "disk",
            "key": " ",
            "format": "        [{mountpoint}] - {size-used} / {size-total} ({size-percentage})"
        },
        "break"
    ]
}
